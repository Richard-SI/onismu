# ---- Banco de dados (PostgreSQL) ----
# Docker Compose expõe o Postgres em 127.0.0.1:5433
DATABASE_URL=postgres://onismu:onismu_dev@127.0.0.1:5433/onismu
# Banco usado SOMENTE pelos testes automatizados (é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgres://onismu:onismu_dev@127.0.0.1:5433/onismu_test
POSTGRES_PASSWORD=onismu_dev

# ---- Servidor ----
PORT=3001
NODE_ENV=development
# Origens autorizadas a chamar a API com credenciais (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173
# Duração da sessão administrativa, em horas
SESSAO_HORAS=12

# ---- Coleta assistida ----
# Provedor de busca: "nenhum" (somente URLs informadas), "searxng" (local e gratuito, via Docker) ou "brave" (API paga)
BUSCA_PROVEDOR=searxng
SEARXNG_URL=http://127.0.0.1:8888
# Pausa entre consultas de busca (ms), por gentileza com os motores consultados
BUSCA_INTERVALO_MS=5000
# Brave Search API (https://brave.com/search/api/) — necessário apenas se BUSCA_PROVEDOR=brave
BRAVE_API_KEY=
# Extrator: "ollama" (modelo local, gratuito), "claude" (API Anthropic, pago) ou "heuristico" (regras, sem IA)
EXTRATOR=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODELO=qwen2.5:7b
OLLAMA_CONTEXTO=16384
OLLAMA_TIMEOUT_MS=600000
# Credencial da API do Claude (Anthropic). Alternativamente, use `ant auth login`.
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5
# Limites de coleta
COLETA_MAX_PAGINAS=25
COLETA_MAX_BYTES=5000000
COLETA_TIMEOUT_MS=15000
COLETA_INTERVALO_HOST_MS=1500
# Contato exibido no User-Agent do coletor (boa prática com os sites consultados)
COLETA_CONTATO=contato@exemplo.org
# NUNCA habilite em produção: permite buscar hosts de rede privada (somente testes)
COLETA_PERMITIR_REDE_PRIVADA=false
